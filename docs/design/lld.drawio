<mxfile host="app.diagrams.net" type="device" pages="2"><diagram name="LLD - Query Flow" id="lld_query"><mxGraphModel dx="1460" dy="759" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q0" value="1. Client POST /ask or /ask/stream (query, filters, session_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="300" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="q1" value="2. Middleware: assign request_id; Auth X-API-Key (authenticates the CLIENT, not the user); Rate limit (memory/redis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="290" y="90" width="320" height="56" as="geometry"/></mxCell><mxCell id="q2" value="3. Guardrails.screen_input(query)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="360" y="160" width="180" height="80" as="geometry"/></mxCell><mxCell id="qrej" value="400 rejected (injection / control chars)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="620" y="180" width="220" height="40" as="geometry"/></mxCell><mxCell id="q3" value="4. Build AccessContext from X-User-Id / X-Roles / X-Sites (if ENABLE_ACL)&#10;⚠ caller-supplied — startup requires TRUST_IDENTITY_HEADERS=true, i.e. a gateway rebuilt them from verified claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="250" y="270" width="400" height="60" as="geometry"/></mxCell><mxCell id="q4" value="5. Orchestrator: load session history; cacheable = no history AND no filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="280" y="340" width="340" height="40" as="geometry"/></mxCell><mxCell id="q5" value="6. Semantic cache hit? (cacheable AND access is None AND cosine &gt;= threshold)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="330" y="410" width="240" height="90" as="geometry"/></mxCell><mxCell id="qcache" value="Replay cached answer (token events + final, cached=true) -&gt; step 15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="620" y="430" width="220" height="50" as="geometry"/></mxCell><mxCell id="q6" value="7. Dispatch by AGENT_MODE" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="360" y="540" width="180" height="90" as="geometry"/></mxCell><mxCell id="ag1" value="8A. AGENT: messages = system + history + user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="60" y="670" width="300" height="40" as="geometry"/></mxCell><mxCell id="ag2" value="9A. provider.chat(messages, tools) [retry/fallback]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="80" y="730" width="260" height="40" as="geometry"/></mxCell><mxCell id="ag3" value="10A. tool_calls present?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="120" y="800" width="180" height="80" as="geometry"/></mxCell><mxCell id="ag4" value="11A. Execute tools: search -&gt; Retriever.hybrid_retrieve -&gt; screen_chunks -&gt; append numbered sources; append tool results; loop (max_steps)&#10;ACL + freshness enter the Qdrant query filter; hybrid_retrieve re-checks ACL at its boundary before anything leaves the retrieval layer" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=6;" parent="1" vertex="1"><mxGeometry x="20" y="910" width="440" height="90" as="geometry"/></mxCell><mxCell id="ag5" value="12A. Final answer text (or forced answer at step limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="70" y="1010" width="280" height="40" as="geometry"/></mxCell><mxCell id="pp1" value="8B. PIPELINE (LangGraph): rewrite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="560" y="670" width="280" height="40" as="geometry"/></mxCell><mxCell id="pp2" value="9B. retrieve (hybrid): ACL + freshness pushed INTO the Qdrant query filter (payload-indexed) -&gt; BM25 ∥ dense -&gt; RRF -&gt; rerank -&gt; ACL boundary re-check -&gt; screen_chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="500" y="730" width="400" height="68" as="geometry"/></mxCell><mxCell id="pp3" value="10B. grade sufficient?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="610" y="800" width="180" height="80" as="geometry"/></mxCell><mxCell id="pp4" value="11B. retries left? -&gt; rewrite (loop). else generate (grounded, cited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="560" y="910" width="280" height="60" as="geometry"/></mxCell><mxCell id="qnote" value="RETRIEVAL NOTES&#10;&#10;ACL is enforced three times on purpose:&#10;1. identity — verified upstream, never from the caller&#10;2. retrieval — inside the Qdrant filter, so top_k holds permitted neighbours instead of being truncated and then filtered&#10;3. boundary — hybrid_retrieve re-checks every result, which also gates the API response's &quot;retrieval&quot; field, not just the LLM context&#10;&#10;Retrieved.metadata carries acl_roles / acl_sites for check 3 and is excluded from to_dict().&#10;&#10;⚠ _embed_lock / _rerank_lock serialize embed + rerank per process: concurrency through rerank is 1 regardless of cores." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="900" y="670" width="300" height="280" as="geometry"/></mxCell><mxCell id="pp5" value="12B. Answer text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="620" y="1010" width="160" height="40" as="geometry"/></mxCell><mxCell id="po1" value="13. Post: ensure_citations (verify + Sources trailer) · faithfulness LLM-judge (opt) · safety assess_risk · online-eval sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1"><mxGeometry x="270" y="1090" width="360" height="60" as="geometry"/></mxCell><mxCell id="po2" value="14. Persist: append (query, answer) to session; put in semantic cache (if cacheable); metrics inc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="270" y="1170" width="360" height="50" as="geometry"/></mxCell><mxCell id="po3" value="15. Respond: JSON (answer, citations, steps, safety, faithfulness, session_id) OR SSE events (rewrite/grade/tool_call/tool_result/token/final)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="250" y="1240" width="400" height="60" as="geometry"/></mxCell><mxCell id="2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q0" target="q1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q1" target="q2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4" value="reject" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q2" target="qrej" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" value="ok" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q2" target="q3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q3" target="q4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q4" target="q5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="hit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q5" target="qcache" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="miss" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q5" target="q6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="agent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q6" target="ag1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="pipeline" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="q6" target="pp1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="ag1" target="ag2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="ag2" target="ag3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="ag3" target="ag4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="loop" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" parent="1" source="ag4" target="ag2" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="870"/><mxPoint x="100" y="870"/></Array></mxGeometry></mxCell><mxCell id="16" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="ag3" target="ag5" edge="1"><mxGeometry x="0.1304" relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="840"/><mxPoint x="460" y="1030"/></Array><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="pp1" target="pp2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="pp2" target="pp3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="19" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="pp3" target="pp4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="20" value="retry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" parent="1" source="pp4" target="pp1" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="940"/><mxPoint x="870" y="690"/></Array></mxGeometry></mxCell><mxCell id="21" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="pp3" target="pp5" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="840"/><mxPoint x="540" y="1030"/></Array></mxGeometry></mxCell><mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="pp4" target="pp5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="ag5" target="po1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="pp5" target="po1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="po1" target="po2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="26" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="po2" target="po3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="qcache" target="po3" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="455"/><mxPoint x="890" y="1270"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="LLD - Ingestion Flow" id="lld_ingest"><mxGraphModel dx="1460" dy="759" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i0" value="1. scripts/ingest.py [--rebuild --no-contextual --force-cloud]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="300" y="20" width="320" height="40" as="geometry"/></mxCell><mxCell id="i1" value="2. embed_model changed? warn to re-embed. Load acl.json / versions.json / caches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="280" y="90" width="360" height="40" as="geometry"/></mxCell><mxCell id="i2" value="3. For each file: Dispatcher.parse by extension" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="360" y="160" width="200" height="90" as="geometry"/></mxCell><mxCell id="i3a" value="4A. .pdf/.docx -&gt; Docling (OCR if scanned); low-confidence -&gt; cloud fallback (LlamaParse/Azure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="20" y="290" width="270" height="60" as="geometry"/></mxCell><mxCell id="i3b" value="4B. .xlsx -&gt; Excel parser (sheet=section, header-repeat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="320" y="290" width="250" height="60" as="geometry"/></mxCell><mxCell id="i3c" value="4C. .md -&gt; Markdown parser (sections + tables)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="600" y="290" width="250" height="60" as="geometry"/></mxCell><mxCell id="i4" value="5. ParsedDocument = list of elements (text / table / figure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="300" y="390" width="320" height="40" as="geometry"/></mxCell><mxCell id="i5" value="6. Chunk per element: text -&gt; word windows; table -&gt; atomic; figure -&gt; vision caption (cached)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="270" y="460" width="380" height="50" as="geometry"/></mxCell><mxCell id="i6" value="7. Contextual augment (LLM blurb, cached on the CONTENT hash) + attach metadata: source_file, element_type, page, acl_roles/sites, doc_version/date/status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="250" y="540" width="420" height="60" as="geometry"/></mxCell><mxCell id="i7" value="8. Diff manifest on the INDEX hash (content + ACL / version metadata): new / changed / stale" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="330" y="630" width="260" height="110" as="geometry"/></mxCell><mxCell id="i8" value="9. Embed new/changed; upsert to Qdrant (deterministic uuid5 ids); delete stale points;&#10;ensure_payload_indexes() on every run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="60" y="760" width="330" height="70" as="geometry"/></mxCell><mxCell id="inote" value="WHY THE INDEX HASH, NOT THE CONTENT HASH&#10;&#10;The manifest hash decides what is re-upserted. On a content-only hash, populating data/acl.json leaves every hash unchanged, so to_upsert is empty: chunks.json is rewritten with the new ACL and the Qdrant payload stays stale.&#10;&#10;⇒ sparse (reads chunks.json) enforces ACLs while dense (reads the payload) serves restricted chunks — and it looks correct, because the sparse denials are real.&#10;&#10;The context cache stays on the content hash, so an ACL edit does not re-run the augmentation LLM calls.&#10;&#10;Payload indexes run every ingest: create_collection is skipped for a collection that already exists, so an existing one would never acquire them." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="720" y="600" width="310" height="290" as="geometry"/></mxCell><mxCell id="i9" value="10. Write chunks.json (BM25 source), manifest, caches, index_meta (embed_model)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="470" y="750" width="220" height="80" as="geometry"/></mxCell><mxCell id="2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i0" target="i1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i1" target="i2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i2" target="i3a" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i2" target="i3b" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i2" target="i3c" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="i3a" target="i4" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="410"/></Array></mxGeometry></mxCell><mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i3b" target="i4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i3c" target="i4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i4" target="i5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i5" target="i6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i6" target="i7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="new/changed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i7" target="i8" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="14" value="stale" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i7" target="i9" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" parent="1" source="i8" target="i9" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
