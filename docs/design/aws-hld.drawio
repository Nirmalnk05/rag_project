<mxfile host="app.diagrams.net" type="device">
  <diagram name="AWS HLD - Deployment" id="aws_hld">
    <mxGraphModel dx="1460" dy="759" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="zaws" value="AWS account  ·  single region" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="800" height="1120" as="geometry"/></mxCell>
        <mxCell id="zpub" value="Public subnets (multi-AZ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="70" y="200" width="740" height="170" as="geometry"/></mxCell>
        <mxCell id="zpriv" value="Private subnets (multi-AZ)  ·  tasks have no public IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#82b366;" parent="1" vertex="1"><mxGeometry x="70" y="390" width="740" height="500" as="geometry"/></mxCell>
        <mxCell id="ztask" value="ECS task — one OS process, one Python process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="90" y="478" width="700" height="210" as="geometry"/></mxCell>
        <mxCell id="zext" value="Managed / external services — reached over the network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#b85450;" parent="1" vertex="1"><mxGeometry x="70" y="920" width="740" height="230" as="geometry"/></mxCell>

        <mxCell id="lgd" value="LEGEND&#10;1–9 = request path (top -&gt; bottom)&#10;Cylinders = data stores&#10;Dashed zones = network boundaries&#10;Red dashed box = NOT BUILT, see aws.md §9&#10;⚠ = hazard or decision still open&#10;Detail: aws-lld.drawio (3 pages)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="880" y="40" width="270" height="130" as="geometry"/></mxCell>

        <mxCell id="ing" value="INGESTION  (separate ECS task — scheduled or S3-triggered; not Lambda)&#10;I1  s3://…/raw/ -&gt; ingest.py&#10;I2  parse (Docling / Excel / Markdown) -&gt; chunk&#10;I3  contextual augment + figure captions&#10;I4  diff manifest (content hash)&#10;I5  write Qdrant collection v{N+1} + s3://…/index/v{N+1}/&#10;&#10;⚠ PARSE_BACKEND=hybrid re-sends low-confidence documents to LlamaParse / Azure. Set it to local (§6.3)." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="880" y="195" width="270" height="235" as="geometry"/></mxCell>

        <mxCell id="pub" value="INDEX PUBLISH  (blue/green — §4.1)&#10;P1  new Qdrant collection v{N+1}&#10;P2  all 7 artifacts -&gt; s3://…/index/v{N+1}/&#10;P3  verify the set is complete&#10;P4  atomic pointer flip: index/current&#10;P5  rolling redeploy; drop v{N} after retention&#10;&#10;Zero skew, but every publish rewrites the whole collection — see aws-lld page 2." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="880" y="455" width="270" height="195" as="geometry"/></mxCell>

        <mxCell id="nb" value="NOT BUILT YET  (aws.md §9)&#10;1  Verified-JWT identity + ACL enablement&#10;2  Qdrant URL / API key / TLS&#10;3  JWT instead of X-API-Key in the browser&#10;4  BM25-only fallback on Qdrant failure&#10;5  /ready probes Qdrant and Redis&#10;6  Durable feedback store&#10;7  backup_index.py -&gt; S3&#10;8  bedrock provider&#10;9  ACL-aware semantic cache&#10;10 Sparse index out of process&#10;&#10;Items 1–3 gate any public deployment." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="880" y="675" width="270" height="250" as="geometry"/></mxCell>

        <mxCell id="gap" value="NOT IN THIS DIAGRAM&#10;· No IAM policies or role split&#10;· No security-group rules&#10;· No Terraform / CDK anywhere in the repo&#10;· No RPO / RTO or restore test&#10;(aws.md §11 caveat 5, §12 q6)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;strokeColor=#666666;spacingLeft=8;verticalAlign=top;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="880" y="950" width="270" height="130" as="geometry"/></mxCell>

        <mxCell id="u1" value="1. Browser users&#10;Chat UI served at GET /" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="60" y="40" width="230" height="44" as="geometry"/></mxCell>
        <mxCell id="u2" value="1. Machine callers&#10;eval harness · CI · integrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="310" y="40" width="230" height="44" as="geometry"/></mxCell>
        <mxCell id="r53" value="2. Route 53  +  ACM (TLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="90" y="150" width="700" height="36" as="geometry"/></mxCell>

        <mxCell id="alb" value="3. Application Load Balancer&#10;⚠ raise the idle timeout above max generation time — SSE (§5.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" parent="1" vertex="1"><mxGeometry x="90" y="232" width="390" height="50" as="geometry"/></mxCell>
        <mxCell id="waf0" value="AWS WAF&#10;web ACL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="500" y="232" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="cog" value="Cognito user pool&#10;(or corporate OIDC / SAML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="660" y="232" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="albr1" value="3a. app.example.com&#10;authenticate-oidc -&gt; injects signed x-amzn-oidc-data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="90" y="300" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="albr2" value="3b. api.example.com&#10;no OIDC — X-API-Key enforced in-app  ·  deny /metrics here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1"><mxGeometry x="440" y="300" width="350" height="50" as="geometry"/></mxCell>

        <mxCell id="ecs" value="4. ECS Fargate service  ·  rag-app  ·  N tasks&#10;fixed desired-count sized for peak — cold start makes reactive autoscaling ineffective (§7.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" parent="1" vertex="1"><mxGeometry x="90" y="418" width="700" height="50" as="geometry"/></mxCell>

        <mxCell id="tk1" value="5. FastAPI + uvicorn&#10;same container serves the Chat UI at /" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1"><mxGeometry x="110" y="512" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="tk2" value="6. Verify x-amzn-oidc-data -&gt; AccessContext&#10;NOT BUILT — §9 item 1 (+ ENABLE_ACL=true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;" parent="1" vertex="1"><mxGeometry x="450" y="512" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="tk3" value="7. Orchestrator (agent | pipeline)&#10;semantic cache is inert while ACLs are on (§5.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1"><mxGeometry x="110" y="570" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="tk4" value="8. hybrid_retrieve: BM25 ∥ dense -&gt; RRF -&gt; rerank&#10;embed + rerank locks serialize per task (§7.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="450" y="570" width="320" height="44" as="geometry"/></mxCell>
        <mxCell id="tk5" value="Resident in every task: the whole chunks.json corpus + the BM25 index + embedder + cross-encoder&#10;⚠ this is what makes the task stateful — start at 2 vCPU / 8 GB and measure (§3.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1"><mxGeometry x="110" y="628" width="660" height="46" as="geometry"/></mxCell>

        <mxCell id="redis" value="ElastiCache Redis&#10;rate limit · sessions" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="90" y="710" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="qds" value="Qdrant self-hosted&#10;(residency alternative)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" parent="1" vertex="1"><mxGeometry x="320" y="710" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="vpce" value="VPC endpoints&#10;S3 (gw) · Bedrock · Secrets · ECR · Logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="550" y="710" width="240" height="66" as="geometry"/></mxCell>
        <mxCell id="sec" value="Secrets Manager / SSM Parameter Store -&gt; injected as env vars at task start (never baked into the image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="90" y="800" width="700" height="40" as="geometry"/></mxCell>

        <mxCell id="s3" value="S3&#10;index/v{N}/ (7 artifacts)&#10;raw docs · backups" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1"><mxGeometry x="90" y="960" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="br" value="9. Amazon Bedrock (Claude)&#10;NOT BUILT — §9 item 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;" parent="1" vertex="1"><mxGeometry x="320" y="960" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="qdc" value="Qdrant Cloud — off-account&#10;holds chunk text + vectors&#10;NOT ADDRESSABLE — §9 item 2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=8 4;" parent="1" vertex="1"><mxGeometry x="550" y="960" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="egr" value="⚠ EGRESS, ranked by sensitivity (§6.4):   Qdrant Cloud = the full corpus leaves the account   ·   PARSE_BACKEND=hybrid = whole source documents leave it&#10;Bedrock = prompts + context, in-AWS same-region   ·   Langfuse Cloud = prompts + answers, off unless LANGFUSE_* is set" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="90" y="1060" width="700" height="60" as="geometry"/></mxCell>

        <mxCell id="obs" value="Cross-cutting observability:   /metrics is already Prometheus-format -&gt; AMP + AMG (scrape inside the VPC, not through the ALB)   ·   structured JSON logs -&gt; CloudWatch via awslogs   ·   Langfuse self-hosted in-VPC or left unset (§8)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fad7ac;strokeColor=#b46504;spacingLeft=8;" parent="1" vertex="1"><mxGeometry x="70" y="1170" width="740" height="46" as="geometry"/></mxCell>

        <mxCell id="eu1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="u1" target="r53" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="u2" target="r53" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="r53" target="alb" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="alb" target="albr1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="alb" target="albr2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ecg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;dashed=1;" parent="1" source="cog" target="albr1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ewf" value="associated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;" parent="1" source="waf0" target="alb" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="albr1" target="ecs" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="albr2" target="ecs" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="tk3" target="tk4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3r" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;dashed=1;" parent="1" source="tk3" target="redis" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4q" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" parent="1" source="tk4" target="qds" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4c" value="NAT egress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="tk4" target="qdc" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="592"/><mxPoint x="830" y="998"/></Array></mxGeometry></mxCell>
        <mxCell id="e4b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="1" source="vpce" target="br" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ets" value="startup: fetch index/v{N}/ (§4.3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" parent="1" source="s3" target="tk5" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="998"/><mxPoint x="60" y="651"/></Array></mxGeometry></mxCell>
