# Fully offline / air-gapped profile. Copy to .env for docker-compose.offline.yml.
# No component in this profile reaches the internet at runtime.

# --- LLM: local via Ollama (tool-capable model required for agent mode) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
ANSWER_MODEL=llama3.1
GRADER_MODEL=llama3.1
CONTEXT_AUG_MODEL=llama3.1

# --- Agent mode needs a tool-capable model; llama3.1 supports tools ---
AGENT_MODE=agent

# --- Parsing: local only (no cloud fallback) ---
PARSE_BACKEND=local

# --- Figure captioning: local vision model, or leave blank to disable ---
ENABLE_FIGURE_CAPTION=true
VISION_MODEL=llama3.2-vision

# --- Local model weights load from the baked HF cache, never the network ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Qdrant (in-cluster) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Rate limiting: in-memory is fine for single-node on-prem ---
RATE_LIMIT_BACKEND=memory

# --- Tracing OFF (cloud Langfuse unreachable air-gapped; self-host if needed) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Auth (set keys to require X-API-Key) ---
API_KEYS=
