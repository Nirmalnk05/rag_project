# --- Provider selection: anthropic | ollama | openai_compatible ---
LLM_PROVIDER=anthropic

# Anthropic (required only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible (LLM_PROVIDER=openai_compatible: vLLM, LM Studio, OpenAI...)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=

# Per-role models — set to models the active provider understands, e.g. for
# ollama: ANSWER_MODEL=qwen2.5:14b  GRADER_MODEL=llama3.1:8b  CONTEXT_AUG_MODEL=llama3.1:8b
ANSWER_MODEL=claude-sonnet-4-20250514
GRADER_MODEL=claude-haiku-4-5-20251001
CONTEXT_AUG_MODEL=claude-haiku-4-5-20251001

# Embedding + reranker (run locally regardless of LLM provider)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# LLM behavior
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=3
FALLBACK_MODEL=

# Qdrant (defaults match docker-compose.yml)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=maintenance_docs

# Retrieval tuning
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=5
MAX_RETRIES=2

# Security (empty API_KEYS = auth disabled)
API_KEYS=
RATE_LIMIT_RPM=30

# Guardrails
REDACT_PII_IN_ANSWERS=false

# --- Orchestration mode ---
# agent = LLM reasons and calls tools (needs a tool-capable model);
# pipeline = fixed corrective-RAG graph (rewrite->retrieve->grade->generate)
AGENT_MODE=agent
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_RESULTS_CHARS=4000

# --- Conversation memory (multi-turn) ---
ENABLE_MEMORY=true
MEMORY_BACKEND=memory          # memory | redis (redis shares across replicas)
MEMORY_MAX_TURNS=10            # user+assistant pairs kept per session
MEMORY_TTL_S=3600

# --- Access control (per-user retrieval ACLs) ---
# When on, retrieval is filtered by the request principal (X-User-Id / X-Roles /
# X-Sites headers) against per-document ACLs in data/acl.json.
ENABLE_ACL=false

# Those headers are caller-supplied: with ENABLE_ACL on and nothing in front of
# the app, "X-Roles: admin" reads every document. Set this only when a gateway
# authenticates the user and rebuilds the headers from verified claims (OIDC /
# LDAP). ENABLE_ACL=true refuses to start without it, and so does an existing
# data/acl.json while ENABLE_ACL is false (ACLs would be silently inert).
TRUST_IDENTITY_HEADERS=false

# --- Index generation / corpus reload ---
# data/chunks.json is a startup snapshot. Ingestion claims a generation in
# data/index_meta.json BEFORE it touches Qdrant, so a serving process can tell
# that the index has moved past its snapshot: while it is behind, the sparse leg
# re-resolves metadata from Qdrant and drops chunks the index no longer holds, so
# a revocation or deletion applies at once. This is how often it then checks for
# a newer committed generation and rebuilds chunks.json + BM25 off the request
# path (that reload is what makes NEW documents keyword-searchable). It holds
# both corpora while it runs, so peak RAM is ~2x the chunk store. 0 disables it.
INDEX_RELOAD_POLL_S=60

# --- Chunking (sized in TOKENS, not words) ---
# bge-small takes 512 tokens and truncates the rest in silence. Measured
# tokens-per-word: prose 1.23, table rows 1.57, codes+units 2.56, CJK 5.21 — a
# 4x spread, so no word target fits: the old 600-word window measured 743 tokens
# and lost 31% of every full chunk, degrading only DENSE recall on the tail.
# Windows are measured with the embedding model's own tokenizer and cut on word
# boundaries; what still cannot fit (an atomic table, say) is reported at ingest.
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# embed_text is the contextual blurb + the chunk, so the blurb needs its own
# share of the 512 or every full chunk loses its tail again.
CHUNK_CONTEXT_RESERVE_TOKENS=128

# --- Document freshness / versioning ---
# Revisions are tagged in data/versions.json; superseded revisions are hidden
# from retrieval unless this is true.
RETRIEVE_SUPERSEDED=false

# --- Answer safety + faithfulness ---
ENABLE_SAFETY_ESCALATION=true      # prepend safety notices for high-risk topics
ENABLE_FAITHFULNESS_CHECK=false    # extra LLM-judge call per answer (groundedness)

# --- Semantic answer cache (PARTITIONED by visibility, not skipped) ---
# Keyed on the principal's visibility (sorted roles + sites) plus the index
# generation, so two users with the same grants share an answer, different
# visibility never does, and an ingest invalidates everything. Still skipped
# when there is conversation history or a filter is applied.
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_MAX=1000

# --- Guardrails backend (heuristic default; external = plug LlamaGuard/NeMo) ---
GUARDRAILS_BACKEND=heuristic

# --- Feedback + online eval ---
FEEDBACK_PATH=data/feedback.jsonl
ONLINE_EVAL_SAMPLE_RATE=0.0        # fraction of answers logged for review (0-1)

# --- Prompt registry ---
PROMPT_VERSION=v1

# --- CMMS / system-of-record connector (agent tool) ---
ENABLE_CMMS=false
CMMS_CONNECTOR=mock            # mock | (add real SAP PM / Maximo / Fiix connectors)

# --- Document parsing (multi-format ingestion) ---
# local = Docling only (offline); cloud = always cloud; hybrid = local + cloud fallback
PARSE_BACKEND=hybrid
CLOUD_PARSE_PROVIDER=llamaparse       # llamaparse | azure
LLAMAPARSE_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
CLOUD_PARSE_MIN_CHARS=200             # local result below this => try cloud (hybrid)
OCR_ENGINE=easyocr                    # easyocr | tesseract
OCR_LANGUAGES=en

# --- Figure captioning (vision) ---
ENABLE_FIGURE_CAPTION=true
# Set a vision-capable model or captioning stays off. Examples:
#   anthropic:  VISION_MODEL=claude-sonnet-4-20250514
#   ollama:     VISION_MODEL=llama3.2-vision
VISION_MODEL=

# Langfuse tracing (optional - leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
