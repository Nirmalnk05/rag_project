# --- Provider selection: anthropic | ollama | openai_compatible ---
LLM_PROVIDER=anthropic

# Anthropic (required only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible (LLM_PROVIDER=openai_compatible: vLLM, LM Studio, OpenAI...)
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=

# Per-role models — set to models the active provider understands, e.g. for
# ollama: ANSWER_MODEL=qwen2.5:14b  GRADER_MODEL=llama3.1:8b  CONTEXT_AUG_MODEL=llama3.1:8b
ANSWER_MODEL=claude-sonnet-4-20250514
GRADER_MODEL=claude-haiku-4-5-20251001
CONTEXT_AUG_MODEL=claude-haiku-4-5-20251001

# Embedding + reranker (run locally regardless of LLM provider)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# LLM behavior
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=3
FALLBACK_MODEL=

# Qdrant (defaults match docker-compose.yml)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=maintenance_docs

# Retrieval tuning
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANK=5
MAX_RETRIES=2

# Security (empty API_KEYS = auth disabled)
API_KEYS=
RATE_LIMIT_RPM=30

# Guardrails
REDACT_PII_IN_ANSWERS=false

# --- Orchestration mode ---
# agent = LLM reasons and calls tools (needs a tool-capable model);
# pipeline = fixed corrective-RAG graph (rewrite->retrieve->grade->generate)
AGENT_MODE=agent
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_RESULTS_CHARS=4000

# --- Conversation memory (multi-turn) ---
ENABLE_MEMORY=true
MEMORY_BACKEND=memory          # memory | redis (redis shares across replicas)
MEMORY_MAX_TURNS=10            # user+assistant pairs kept per session
MEMORY_TTL_S=3600

# --- Access control (per-user retrieval ACLs) ---
# When on, retrieval is filtered by the request principal (X-User-Id / X-Roles /
# X-Sites headers) against per-document ACLs in data/acl.json.
ENABLE_ACL=false

# --- Document freshness / versioning ---
# Revisions are tagged in data/versions.json; superseded revisions are hidden
# from retrieval unless this is true.
RETRIEVE_SUPERSEDED=false

# --- Answer safety + faithfulness ---
ENABLE_SAFETY_ESCALATION=true      # prepend safety notices for high-risk topics
ENABLE_FAITHFULNESS_CHECK=false    # extra LLM-judge call per answer (groundedness)

# --- Semantic answer cache (skipped when ACLs are on) ---
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_MAX=1000

# --- Guardrails backend (heuristic default; external = plug LlamaGuard/NeMo) ---
GUARDRAILS_BACKEND=heuristic

# --- CMMS / system-of-record connector (agent tool) ---
ENABLE_CMMS=false
CMMS_CONNECTOR=mock            # mock | (add real SAP PM / Maximo / Fiix connectors)

# --- Document parsing (multi-format ingestion) ---
# local = Docling only (offline); cloud = always cloud; hybrid = local + cloud fallback
PARSE_BACKEND=hybrid
CLOUD_PARSE_PROVIDER=llamaparse       # llamaparse | azure
LLAMAPARSE_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
CLOUD_PARSE_MIN_CHARS=200             # local result below this => try cloud (hybrid)
OCR_ENGINE=easyocr                    # easyocr | tesseract
OCR_LANGUAGES=en

# --- Figure captioning (vision) ---
ENABLE_FIGURE_CAPTION=true
# Set a vision-capable model or captioning stays off. Examples:
#   anthropic:  VISION_MODEL=claude-sonnet-4-20250514
#   ollama:     VISION_MODEL=llama3.2-vision
VISION_MODEL=

# Langfuse tracing (optional - leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
